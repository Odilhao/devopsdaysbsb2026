{#-
  One template, every language. Structure + layouts live here; all text lives in
  i18n/<lang>.yaml (already rendered, so numbers are filled in), reachable as t.<slide>.<field>.
  Numbers used directly here come from n (see scripts/build_slidev.py: load_data).
  Filters: y = YAML-safe value, num/pct = locale numbers, month/day = locale dates.
  Theme contract: https://github.com/zcag/tahta/blob/main/packages/theme/AGENTS.md
-#}
{%- macro notes(s) %}{% if s.get("notes") %}

<!--
{{ s.notes }}
-->
{% endif %}{% endmacro -%}
---
theme: slidev-theme-tahta
title: {{ t.cover.title | y }}
author: Odilon Junior
mdc: true
routerMode: hash
download: true
exportFilename: devopsdaysbsb2026-{{ lang }}
themeConfig:
  variant: boardroom
  accent: "#EB6834"
  lang: {{ lang | y }}
layout: cover
kicker: {{ t.cover.kicker | y }}
subtitle: {{ t.cover.subtitle | y }}
---
{{ notes(t.cover) }}
---
layout: two-cols
class: light
title: {{ t.whoami.title | y }}
foot: {{ t.whoami.foot | y }}
---

<Tags :items="{{ t.whoami.tags | js }}" />

{% for b in t.whoami.bullets %}
- {{ b }}
{% endfor %}

::right::

<Terminal title="odilon@brasilia" :lines="{{ t.whoami.terminal | js }}" />

{% for l in t.whoami.links %}
- [{{ l.label }}]({{ l.url }})
{% endfor %}
{{ notes(t.whoami) }}
