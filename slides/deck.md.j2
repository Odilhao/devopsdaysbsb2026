---
layout: default
class: light
kicker: {{ t.signals.kicker | y }}
title: {{ t.signals.title | y }}
foot: {{ t.signals.foot | y }}
---

{% set grid = [t.signals.head] %}
{% for c in t.signals.cases %}
{% set r = n.case[c.cve] %}
{% set _ = grid.append([
    c.label,
    r.cna_cvss | num(1),
    r.github_severity or t.signals.no_record,
    r.epss | pct(1),
    (r.kev_added | day) if r.kev_added else t.signals.not_in_kev,
]) %}
{% endfor %}
<Grid :data="{{ grid | js }}" head />

<Callout tone="warn" icon="lucide:crosshair">{{ t.signals.callout }}</Callout>
{{ notes(t.signals) }}
